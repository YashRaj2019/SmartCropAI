# SmartCrop AI - Environment Configuration Template

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Machine Learning Runtime Settings
# "production" uses trained deep learning and XGBoost model weights
# "demo" uses fast biophysical rule-based estimators
ML_MODE=production
DISEASE_MODEL_PATH=models/disease/model.pt
YIELD_MODEL_PATH=models/yield/model.joblib
RISK_MODEL_PATH=models/risk/model.joblib
ENABLE_EXPLANATIONS=true
CONFIDENCE_THRESHOLD=0.60

# Database Persistence
# Set to your MongoDB connection URI (e.g. MongoDB Atlas or Docker service)
# If left unset or unreachable, SmartCrop AI automatically falls back to local JSON storage
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=smartcrop_db

# Local File Storage Paths
STORAGE_DIR=storage

# External Integrations
# Optional: OpenWeatherMap API Key for live weather retrieval in field telemetry
WEATHER_API_KEY=

# Frontend Environment Variables (Set when building the React frontend)
# If frontend is served on the same domain/port, default is /api
VITE_API_URL=http://localhost:8000/api
